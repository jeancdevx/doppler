---
import HeroAcousticCanvas from './HeroAcousticCanvas.svelte'
---

<section
  class='relative flex min-h-[min(92svh,840px)] flex-col justify-between overflow-hidden bg-[#090f1d] pt-24 pb-0 text-[#f5f3ec]'
  aria-labelledby='hero-title'
>
  <HeroAcousticCanvas client:load />

  <div class='relative z-10 mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-center px-5 py-10 md:px-8 lg:py-14'>
    <div class='grid grid-cols-1 items-end gap-10 lg:grid-cols-12'>
      <!-- Bloque editorial protagonista con máximo contraste sobre escudo radial obsidiana -->
      <div class='flex max-w-[740px] flex-col gap-6 lg:col-span-8'>
        <div class='flex flex-wrap items-center gap-3'>
          <span class='caption-4 inline-flex items-center gap-2 rounded-full border border-[#34435c] bg-[#0d172b]/95 px-3.5 py-1.5 font-mono text-[#b8c8ff] shadow-sm'>
            <span class='relative flex size-2'>
              <span class='live-pulse-ring absolute inline-flex size-full rounded-full bg-[#86d6b8]'></span>
              <span class='relative inline-flex size-2 rounded-full bg-[#86d6b8]'></span>
            </span>
            RESNET18 LOG-MEL · VALIDACIÓN LOCAL + R2 REAL
          </span>
        </div>

        <h1
          id='hero-title'
          class='heading-display text-[#f8f7f2] drop-shadow-[0_6px_28px_rgba(9,15,29,0.92)]'
        >
          Del ruido
          <br />
          <span class='hero-headline-accent'>a la señal.</span>
        </h1>

        <p class='body-3 max-w-[560px] text-base text-[#d5dce8] drop-shadow-[0_2px_12px_rgba(9,15,29,0.9)] sm:text-lg'>
          Instrumento acústico de detección binaria de sirenas. Carga un archivo
          WAV en Cloudflare R2 privado, inspecciona su forma de onda y
          espectrograma reales y revisa cada ventana de tres segundos frente al
          umbral congelado.
        </p>

        <div class='flex flex-wrap items-center gap-5 pt-2'>
          <span class='beam-button-wrap'>
            <button
              id='hero-upload-cta'
              type='button'
              class='interactive-lift beam-button-inner button-md inline-flex min-h-[50px] cursor-pointer items-center gap-3 bg-[#3156d3] px-6 py-3 text-white hover:bg-[#2643a8]'
            >
              <span>Cargar archivo WAV</span>
              <svg
                class='size-5'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.8'
                aria-hidden='true'
              >
                <path d='M12 19V5m-6 6 6-6 6 6'></path>
              </svg>
            </button>
          </span>

          <a
            href='#recorrido'
            class='button-sm inline-flex min-h-[44px] items-center gap-2 border-b border-[#5a78e6]/60 px-1 py-2 text-[#d5dce8] transition-colors hover:border-[#9bb1ff] hover:text-white'
          >
            <span>Recorrer el pipeline</span>
            <svg
              class='size-4'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.6'
              aria-hidden='true'
            >
              <path d='M12 5v14m-6-6 6 6 6-6'></path>
            </svg>
          </a>
        </div>

        <p class='caption-4 inline-flex w-fit flex-wrap items-center gap-2 rounded-lg border border-[#34435c]/70 bg-[#090f1d]/80 px-3 py-1.5 font-mono text-[#b0bacb] backdrop-blur-sm'>
          WAV hasta 25 MiB y 120 s · Retención automática 24 h en R2 privado ·
          Eliminación inmediata
        </p>
      </div>

      <!-- Tarjeta de telemetría congelada del instrumento -->
      <div class='lg:col-span-4'>
        <div class='rounded-2xl border border-[#34435c]/90 bg-[#0d172b]/90 p-5 shadow-[0_18px_48px_-20px_rgba(0,0,0,0.8)] backdrop-blur-md'>
          <div class='flex items-center justify-between border-b border-[#34435c] pb-3 font-mono text-[11px] text-[#9bb1ff]'>
            <span>CONTRATO DE INFERENCIA</span>
            <span>05_RESNET18</span>
          </div>
          <dl class='mt-4 grid grid-cols-2 gap-x-4 gap-y-3 font-mono text-xs'>
            <div>
              <dt class='text-[10px] text-[#949fb3]'>FRECUENCIA</dt>
              <dd class='mt-0.5 text-[#f5f3ec]'>16 000 Hz · soxr_hq</dd>
            </div>
            <div>
              <dt class='text-[10px] text-[#949fb3]'>SEGMENTACIÓN</dt>
              <dd class='mt-0.5 text-[#f5f3ec]'>3,0 s / salto 1,5 s</dd>
            </div>
            <div>
              <dt class='text-[10px] text-[#949fb3]'>REPRESENTACIÓN</dt>
              <dd class='mt-0.5 text-[#f5f3ec]'>Log-Mel 64 × 94</dd>
            </div>
            <div>
              <dt class='text-[10px] text-[#949fb3]'>UMBRAL SIGMOIDE</dt>
              <dd class='mt-0.5 text-[#ffdf9f]'>0,6548 (congelado)</dd>
            </div>
          </dl>
          <p class='mt-4 border-t border-[#34435c] pt-3 text-[11px] text-[#bdc4d1]'>
            Composición superior interactiva de portada. Los espectrogramas del
            estudio se calculan directamente desde cada archivo WAV cargado.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Regla acústica calibrada estilo Teenage Engineering -->
  <div class='relative z-10 border-t border-[#34435c]/80 bg-[#090f1d]/95'>
    <div class='acoustic-ruler mx-auto max-w-[1440px] px-5 pt-3 pb-4 md:px-8'>
      <div class='flex flex-wrap items-center justify-between gap-4 font-mono text-[11px] text-[#949fb3] tabular-nums'>
        <span>00:00.0</span>
        <span class='hidden sm:inline'>00:01.5 · VENTANA 01</span>
        <span>00:03.0 · SOLAPE 50 %</span>
        <span class='hidden md:inline'>00:04.5 · LOG-MEL 20–8000 HZ</span>
        <span class='text-[#9bb1ff]'>
          00:06.0 · CONCURRENCIA 1 · CPU FLOAT32
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('hero-upload-cta')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('doppler:trigger-upload'))
  })
</script>
