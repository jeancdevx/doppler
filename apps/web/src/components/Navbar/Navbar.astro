---
---

<header class='fixed top-0 right-0 left-0 z-40 px-4 pt-3 sm:px-8'>
  <div class='glass-bar relative mx-auto flex max-w-[1440px] items-center justify-between gap-4 overflow-hidden rounded-2xl border border-[#34435c]/85 bg-[#090f1d]/86 px-4 py-2.5 text-[#f5f3ec] shadow-[0_14px_40px_-14px_rgba(0,0,0,0.72)] backdrop-blur-xl sm:px-5'>
    <!-- Reflejo especular superior de 1px estilo instrumento -->
    <div
      class='pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[#9bb1ff]/45 to-transparent'
      aria-hidden='true'
    ></div>

    <!-- Marca + telemetría de estado -->
    <div class='flex min-w-0 items-center gap-3.5'>
      <a href='/' aria-label='Doppler, inicio' class='shrink-0'>
        <img
          src='/logos/doppler-horizontal-reverse.svg'
          alt='doppler'
          width='134'
          height='32'
          class='h-7 w-auto sm:h-8'
        />
      </a>

      <span
        class='hidden h-5 w-px bg-[#34435c]/80 xl:inline-block'
        aria-hidden='true'
      ></span>

      <span class='hidden items-center gap-2 rounded-full border border-[#34435c]/75 bg-[#101b30]/85 px-2.5 py-1 font-mono text-[10px] tracking-[0.06em] text-[#bdc4d1] xl:inline-flex'>
        <span class='relative flex size-1.5' aria-hidden='true'>
          <span class='live-pulse-ring absolute inline-flex size-full rounded-full bg-[#86d6b8]'></span>
          <span class='relative inline-flex size-1.5 rounded-full bg-[#86d6b8]'></span>
        </span>
        RESNET18 · R2 PRIVADO
      </span>
    </div>

    <!-- Píldora central numerada con scroll-spy -->
    <nav
      class='hidden items-center gap-1 rounded-xl border border-[#34435c]/75 bg-[#101b30]/75 p-1 md:flex'
      aria-label='Navegación principal'
    >
      <a
        href='#recorrido'
        data-nav-target='recorrido'
        class='nav-pill inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-[#bdc4d1] transition-colors hover:text-[#f5f3ec]'
      >
        <span class='font-mono text-[10px] text-[#9bb1ff]/75'>01</span>
        <span>Recorrido</span>
      </a>
      <a
        href='#studio'
        data-nav-target='studio'
        class='nav-pill inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-[#bdc4d1] transition-colors hover:text-[#f5f3ec]'
      >
        <span class='font-mono text-[10px] text-[#9bb1ff]/75'>02</span>
        <span>Estudio</span>
      </a>
      <a
        href='#contrato'
        data-nav-target='contrato'
        class='nav-pill inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-[#bdc4d1] transition-colors hover:text-[#f5f3ec]'
      >
        <span class='font-mono text-[10px] text-[#9bb1ff]/75'>03</span>
        <span>Arquitectura</span>
      </a>
      <a
        href='#faq'
        data-nav-target='faq'
        class='nav-pill inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-[#bdc4d1] transition-colors hover:text-[#f5f3ec]'
      >
        <span class='font-mono text-[10px] text-[#9bb1ff]/75'>04</span>
        <span>Preguntas</span>
      </a>
    </nav>

    <!-- Acción principal + botón móvil -->
    <div class='flex items-center gap-2.5'>
      <a
        href='#studio'
        class='interactive-lift button-sm hidden min-h-[38px] items-center gap-2 rounded-xl border border-[#5a78e6]/65 bg-[#3156d3] px-4 py-1.5 text-white shadow-[0_0_24px_-6px_rgba(49,86,211,0.85)] hover:bg-[#2643a8] md:inline-flex'
      >
        <span>Abrir estudio</span>
        <svg
          class='size-4 text-[#ffdf9f]'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.8'
          aria-hidden='true'
        >
          <path d='M7 17 17 7M7 7h10v10'></path>
        </svg>
      </a>

      <button
        id='mobile-menu-toggle'
        type='button'
        class='flex size-10 items-center justify-center rounded-xl border border-[#34435c] bg-[#101b30] text-[#f5f3ec] md:hidden'
        aria-expanded='false'
        aria-controls='mobile-nav-drawer'
        aria-label='Abrir menú de navegación'
      >
        <svg
          class='size-5'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.8'
          aria-hidden='true'
        >
          <path d='M4 7h16'></path>
          <path d='M4 12h16'></path>
          <path d='M4 17h16'></path>
        </svg>
      </button>
    </div>

    <!-- Barra de progreso espectral en el borde inferior del header -->
    <div
      class='pointer-events-none absolute right-0 bottom-0 left-0 h-[2px] bg-[#172b4d]/50'
      aria-hidden='true'
    >
      <div
        id='header-scroll-progress'
        class='h-full origin-left bg-gradient-to-r from-[#3156d3] via-[#9bb1ff] to-[#f0c779]'
        style='transform: scaleX(0);'
      ></div>
    </div>
  </div>

  <!-- Panel móvil de altura completa -->
  <div
    id='mobile-nav-drawer'
    hidden
    class='fixed inset-0 z-50 flex flex-col justify-between bg-[#090f1d]/96 p-6 text-[#f5f3ec] backdrop-blur-xl md:hidden'
    role='dialog'
    aria-modal='true'
    aria-label='Menú móvil'
  >
    <div class='flex items-center justify-between'>
      <img
        src='/logos/doppler-horizontal-reverse.svg'
        alt='doppler'
        width='130'
        height='32'
        class='h-8 w-auto'
      />
      <button
        id='mobile-menu-close'
        type='button'
        class='flex size-10 items-center justify-center rounded-xl border border-[#34435c] bg-[#101b30] text-[#f5f3ec]'
        aria-label='Cerrar menú'
      >
        <svg
          class='size-5'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.8'
          aria-hidden='true'
        >
          <path d='M6 6l12 12M18 6 6 18'></path>
        </svg>
      </button>
    </div>

    <nav class='flex flex-col gap-5 text-2xl font-medium text-[#f5f3ec]'>
      <a
        href='#recorrido'
        class='mobile-nav-link flex items-baseline gap-3 hover:text-[#9bb1ff]'
      >
        <span class='font-mono text-sm text-[#9bb1ff]'>01</span>
        <span>Recorrido acústico</span>
      </a>
      <a
        href='#studio'
        class='mobile-nav-link flex items-baseline gap-3 hover:text-[#9bb1ff]'
      >
        <span class='font-mono text-sm text-[#9bb1ff]'>02</span>
        <span>Estudio de audio</span>
      </a>
      <a
        href='#contrato'
        class='mobile-nav-link flex items-baseline gap-3 hover:text-[#9bb1ff]'
      >
        <span class='font-mono text-sm text-[#9bb1ff]'>03</span>
        <span>Arquitectura y R2</span>
      </a>
      <a
        href='#faq'
        class='mobile-nav-link flex items-baseline gap-3 hover:text-[#9bb1ff]'
      >
        <span class='font-mono text-sm text-[#9bb1ff]'>04</span>
        <span>Preguntas frecuentes</span>
      </a>
    </nav>

    <div class='border-t border-[#34435c] pt-4'>
      <p class='caption-4 font-mono text-[#949fb3]'>
        DOPPLER / ESPECTRO · VALIDACIÓN LOCAL + R2
      </p>
    </div>
  </div>
</header>

<style>
  .nav-pill[data-active='true'] {
    background-color: #172b4d;
    color: #f5f3ec;
    box-shadow: inset 0 0 0 1px rgba(155, 177, 255, 0.35);
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle')
  const closeBtn = document.getElementById('mobile-menu-close')
  const drawer = document.getElementById('mobile-nav-drawer')
  const links = document.querySelectorAll('.mobile-nav-link')
  const progressBar = document.getElementById('header-scroll-progress')
  const navPills = document.querySelectorAll<HTMLAnchorElement>('.nav-pill')
  const trackedIds = ['recorrido', 'studio', 'contrato', 'faq']

  function setDrawerOpen(open: boolean) {
    if (!drawer || !toggleBtn) {
      return
    }

    drawer.hidden = !open
    toggleBtn.setAttribute('aria-expanded', String(open))
    document.body.style.overflow = open ? 'hidden' : ''

    if (open) {
      closeBtn?.focus()
    } else {
      toggleBtn.focus()
    }
  }

  function updateHeaderScroll() {
    const doc = document.documentElement
    const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight)
    const ratio = Math.max(0, Math.min(1, window.scrollY / maxScroll))

    if (progressBar) {
      progressBar.style.transform = `scaleX(${ratio})`
    }

    let currentId = ''
    const marker = window.innerHeight * 0.35

    for (const id of trackedIds) {
      const el = document.getElementById(id)

      if (!el) {
        continue
      }

      const rect = el.getBoundingClientRect()

      if (rect.top <= marker && rect.bottom > 80) {
        currentId = id
      }
    }

    navPills.forEach(pill => {
      const isActive = pill.dataset.navTarget === currentId

      pill.dataset.active = isActive ? 'true' : 'false'
    })
  }

  toggleBtn?.addEventListener('click', () => setDrawerOpen(true))
  closeBtn?.addEventListener('click', () => setDrawerOpen(false))
  links.forEach(link =>
    link.addEventListener('click', () => setDrawerOpen(false))
  )
  window.addEventListener('keydown', event => {
    if (event.key === 'Escape' && drawer && !drawer.hidden) {
      setDrawerOpen(false)
    }
  })

  updateHeaderScroll()
  window.addEventListener('scroll', updateHeaderScroll, { passive: true })
</script>
