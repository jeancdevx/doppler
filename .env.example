# =============================================================================
# Doppler — Configuración de entorno (plantilla sin secretos)
# Copia este archivo a `.env` y completa las credenciales reales de Cloudflare R2.
# NUNCA subas `.env` a Git, imágenes Docker, logs ni carpetas de evidencia.
# =============================================================================

# --- Cloudflare R2 (obligatorio para almacenamiento real) --------------------
# Identificador de cuenta Cloudflare (32 caracteres hexadecimales)
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
# Credenciales S3 API generadas en Cloudflare R2 (permisos Object Read & Write sobre el bucket)
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
# Nombre del bucket privado de desarrollo (sin acceso público)
R2_BUCKET=doppler-dev-audio
# Prefijo de objetos creados por la aplicación (la limpieza automática se limita a este prefijo)
R2_PREFIX=doppler/uploads/
# Prefijo exclusivo para pruebas automatizadas de integración con R2
R2_TEST_PREFIX=doppler/tests/
# Región compatible con la API S3 de Cloudflare R2 (auto es la recomendada)
R2_REGION=auto
# Endpoint opcional; si está vacío se construye como https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Origen público local y red interna --------------------------------------
# Origen exacto servido por Caddy (usado también para validar/configurar CORS en R2)
APP_ORIGIN=http://localhost:4321
# Puerto local de entrada publicado por Caddy (127.0.0.1)
CADDY_PORT=4321
# Puertos internos publicados SOLO en 127.0.0.1 para inspección y depuración local
API_DEBUG_PORT=18080
INFERENCE_DEBUG_PORT=18090

# --- Artefactos del modelo (solo lectura en el contenedor de inferencia) -----
# Ruta en el host al directorio o archivo checkpoint .pt del modelo ResNet18 entrenado
MODEL_PATH=./Doppler_Espectro_Brand_Kit/model/model.pt
INFERENCE_CONFIG_PATH=./Doppler_Espectro_Brand_Kit/model/inference.json
# Ruta montada dentro del contenedor de inferencia
CONTAINER_MODEL_PATH=/models/model.pt
CONTAINER_INFERENCE_CONFIG_PATH=/models/inference.json

# --- Límites de producto, vencimientos y retención ---------------------------
# Tamaño máximo de archivo WAV permitido (25 MiB = 26214400 bytes)
MAX_FILE_BYTES=26214400
# Duración máxima de audio permitida en segundos
MAX_DURATION_SECONDS=120
# Concurrencia máxima del despachador de inferencia (inicialmente 1)
MAX_CONCURRENT_INFERENCE=1
# Capacidad máxima acotada de trabajos pendientes/en curso en cola SQLite
MAX_QUEUE_DEPTH=16
# Duración de la URL PUT firmada para subida directa navegador -> R2 (segundos)
PRESIGN_PUT_TTL_SECONDS=300
# Duración de la URL GET firmada para reproducción temporal autorizada (segundos)
PRESIGN_GET_TTL_SECONDS=180
# Retención automática de objetos en R2 y trabajos en SQLite (horas)
RETENTION_HOURS=24
# Intervalo del ciclo de limpieza en segundos
CLEANUP_INTERVAL_SECONDS=300
# Número de sesiones/cargas máximas por ventana temporal por IP/sesión
RATE_LIMIT_UPLOADS_PER_HOUR=60

# --- Persistencia SQLite e inferencia interna --------------------------------
DATABASE_URL=sqlite:///data/doppler.db?mode=rwc
INFERENCE_SERVICE_URL=http://inference:8000
INFERENCE_TIMEOUT_SECONDS=120
# Hilos CPU de PyTorch/OpenMP en el contenedor de inferencia
TORCH_NUM_THREADS=4
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
# Secreto HMAC local para firmar cookies de sesión anónima (generar aleatorio en .env)
SESSION_HMAC_SECRET=replace_with_random_64_hex_chars
RUST_LOG=doppler_api=info,tower_http=info
