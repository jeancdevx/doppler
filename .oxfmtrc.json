{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": true,
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "css",
  "jsxSingleQuote": true,
  "printWidth": 80,
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "sortImports": {
    "order": "asc",
    "ignoreCase": false,
    "newlinesBetween": true,
    "internalPattern": ["@/"],
    "sortSideEffects": false,
    "groups": [
      ["builtin", "type-builtin"],
      ["external", "type-external"],
      ["internal", "type-internal", "subpath", "type-subpath"],
      ["parent", "type-parent"],
      ["sibling", "type-sibling", "index", "type-index"],
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "reference/**",
    "specification/**",
    "fixtures/**",
    "assets/**",
    "design/**",
    "handoff/**",
    ".agents/**",
    ".codex/**",
    ".taste-skill/**",
    "Doppler_Espectro_Brand_Kit/**",
    "public/**",
    "apps/web/public/**",
    "**/dist/**",
    "api/**",
    "services/**",
    "evidence/**",
    "docs/**",
    "**/.astro/**",
    "pnpm-lock.yaml",
    "skills-lock.json",
    "AGENTS.md",
    "DESIGN.md",
    "README.md",
    "test-results/**",
    "playwright-report/**",
    "docs/context/**",
    ".husky/_/**",
    "docs/assets-report.json"
  ],
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles/global.css"
  }
}
